{
    "name": "vuikhoe/ecomkit-vuikhoe",
    "description": "WordPress plugin foundation for Ecomkit - Vui Khỏe.",
    "type": "wordpress-plugin",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "phpoffice/phpspreadsheet": "^5.0",
        "smalot/pdfparser": "^2.12.5"
    },
    "autoload": {
        "classmap": [
            "includes/"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "platform": {
            "php": "8.1.0"
        },
        "sort-packages": true
    }
}
